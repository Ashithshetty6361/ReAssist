# ═══════════════════════════════════════════════════════════════════════════════
# ReAssist Environment Configuration (AWS-Powered Multi-Agent Engine)
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported: bedrock, openai, ollama, huggingface
# Set to "bedrock" for AWS Bedrock, or "ollama" for free local models
LLM_PROVIDER=ollama

# ─── AWS Bedrock & S3 Configuration (when LLM_PROVIDER=bedrock or STORAGE_BACKEND=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# S3_BUCKET_NAME=reassist-storage

# ─── Storage Backend ────────────────────────────────────────────────────────
# Supported: local, s3
STORAGE_BACKEND=local

# ─── OpenAI (required only when LLM_PROVIDER=openai) ────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Ollama (required only when LLM_PROVIDER=ollama) ────────────────────────
# Install Ollama from https://ollama.ai then run:
#   ollama pull llama3.1:8b-instruct-q4_K_M
#   ollama pull phi3:mini
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── HuggingFace (required only when LLM_PROVIDER=huggingface) ──────────────
HF_API_KEY=your_huggingface_api_key_here

# ─── Model Override (optional) ──────────────────────────────────────────────
# MODEL_NAME=anthropic.claude-3-5-sonnet-20240620-v1:0

# ─── Hybrid Routing (optional) ──────────────────────────────────────────────
# Fast grader model (e.g. Claude 3 Haiku for Bedrock, Phi-3 for Ollama)
GRADER_PROVIDER=ollama
GRADER_MODEL=phi3:mini

# ─── Embedding Provider ─────────────────────────────────────────────────────
# Supported: bedrock, openai, ollama, huggingface
# "bedrock" uses amazon.titan-embed-text-v2:0, "ollama" uses nomic-embed-text
EMBEDDING_PROVIDER=ollama

# ─── Web Search (optional) ──────────────────────────────────────────────────
# Tavily API key for web search fallback
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Max Papers ─────────────────────────────────────────────────────────────
MAX_PAPERS=7

# ─── Database ───────────────────────────────────────────────────────────────
# Default: SQLite (local). For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/reassist
DATABASE_URL=sqlite:///reassist.db

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_string
